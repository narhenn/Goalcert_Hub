# ── GoalCert Hub Backend — configuration ──────────────────────────────
# Copy to .env and fill in. Everything the browser must never see lives here.

# LLM keys (HiveMind / agentic reasoning that the hub runs itself)
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...
CLAUDE_MODEL=claude-sonnet-4-20250514

# ── Auth / identity ───────────────────────────────────────────────────
# Generate a strong secret:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720

# First platform owner, seeded on first boot (change the password on first login)
SUPER_ADMIN_EMAIL=owner@goalcert.io
SUPER_ADMIN_PASSWORD=ChangeMe!2026
SUPER_ADMIN_NAME=Platform Owner

# ── Persistence (SQLite now, Postgres-ready) ──────────────────────────
# SQLite (default): a file next to the backend. For Postgres, e.g.:
# DATABASE_URL=postgresql+psycopg://user:pass@db-host:5432/goalcert
# DATABASE_URL=sqlite:///./goalcert_hub.db

# ── CORS (production: your deployed frontend origin[s], comma-separated) ─
CORS_ORIGINS=http://localhost:5180,http://localhost:5173

# ── Secure gateway to the 3 platforms ─────────────────────────────────
# Drop in the URL + key you're given for each service and the stub goes real.
# Keys are injected server-side and never reach the browser.
# TWIN_BASE_URL=https://twin.internal.goalcert.io
# TWIN_API_KEY=
# TWIN_PATH_PREFIX=/api/v1
# TWIN_KEY_HEADER=X-API-Key

# ── Simulation Engine ─────────────────────────────────────────────────
# A SEPARATE platform, in its own repo, deployed on its own — exactly like the NextXR
# Digital Twin. No simulation code lives in this repo; the hub only holds a client
# (hub/web/src/modules/simulation) that calls it through the gateway.
#
# Set these two and the Builder / Simulation / Reports / History tabs appear inside
# "Train with AI". Leave them unset and the tab shows a "not connected" notice — the
# hub never fabricates a cascade.
#
# NOTE: the engine mounts its routers at the ROOT (/scenarios, /runs, /catalog,
# /health) — there is no /api prefix on it. SCENARIO_PATH_PREFIX must therefore be
# EMPTY: the default "/api" would rewrite /api/scenario/runs/graph into
# GET {base}/api/runs/graph and 404 every call. This is the easy one to get wrong.
# SCENARIO_BASE_URL=https://simulation-engine.internal.example.com
# SCENARIO_API_KEY=          # must match the key set on the engine itself
SCENARIO_PATH_PREFIX=
# SCENARIO_KEY_HEADER=X-API-Key

# AGENTS_BASE_URL=https://agentic.internal.goalcert.io
# AGENTS_API_KEY=
# AGENTS_PATH_PREFIX=/api
# AGENTS_KEY_HEADER=X-API-Key

# AGENTBUILDER_BASE_URL=http://localhost:8097
# AGENTBUILDER_API_KEY=
# AGENTBUILDER_PATH_PREFIX=/api
# AGENTBUILDER_KEY_HEADER=X-API-Key

# Server
PORT=8090
