# ── GoalCert Hub Backend — configuration ──────────────────────────────
# Copy to .env and fill in. Everything the browser must never see lives here.

# LLM keys (HiveMind / agentic reasoning that the hub runs itself)
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...
CLAUDE_MODEL=claude-sonnet-4-20250514

# ── Auth / identity ───────────────────────────────────────────────────
# Generate a strong secret:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720

# First platform owner, seeded on first boot (change the password on first login)
SUPER_ADMIN_EMAIL=owner@goalcert.io
SUPER_ADMIN_PASSWORD=ChangeMe!2026
SUPER_ADMIN_NAME=Platform Owner

# ── Persistence (SQLite now, Postgres-ready) ──────────────────────────
# SQLite (default): a file next to the backend. For Postgres, e.g.:
# DATABASE_URL=postgresql+psycopg://user:pass@db-host:5432/goalcert
# DATABASE_URL=sqlite:///./goalcert_hub.db

# ── CORS (production: your deployed frontend origin[s], comma-separated) ─
CORS_ORIGINS=http://localhost:5180,http://localhost:5173

# ── Secure gateway to the 3 platforms ─────────────────────────────────
# Drop in the URL + key you're given for each service and the stub goes real.
# Keys are injected server-side and never reach the browser.
# TWIN_BASE_URL=https://twin.internal.goalcert.io
# TWIN_API_KEY=
# TWIN_PATH_PREFIX=/api/v1
# TWIN_KEY_HEADER=X-API-Key

# SCENARIO_BASE_URL=https://scenario.internal.goalcert.io
# SCENARIO_API_KEY=
# SCENARIO_PATH_PREFIX=/api
# SCENARIO_KEY_HEADER=X-API-Key

# AGENTS_BASE_URL=https://agentic.internal.goalcert.io
# AGENTS_API_KEY=
# AGENTS_PATH_PREFIX=/api
# AGENTS_KEY_HEADER=X-API-Key

# Server
PORT=8090
