# ── GoalCert Hub Backend — configuration ──────────────────────────────
# Copy to .env and fill in. Everything the browser must never see lives here.
# This file is the ONLY spec of what the hub needs — .env itself is gitignored,
# so a teammate cloning the repo has this and nothing else. Keep it current.
#
# For AWS, see AWS_DEPLOYMENT.md (§7 has the full production env table).

# ── LLM (the hub runs the Hive's agents itself) ───────────────────────
# ANY ONE is enough — the hub tries Claude → OpenAI → Gemini and falls through
# silently on failure. That fallback hides a bad model id, so:
#
# ⚠ CLAUDE_MODEL must be a CURRENT model. claude-sonnet-4-20250514 is RETIRED —
#   every call 404s with {"type":"not_found_error"} and the hub quietly uses
#   OpenAI instead, so "Claude" agents are not Claude and nothing tells you.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-4o-mini

# ── Auth / identity ───────────────────────────────────────────────────
# openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720

# First platform owner, seeded on first boot (forced password change on first login).
# NOTE this account has org_id = NULL: it is the PLATFORM OWNER, not a tenant, and
# deliberately sees no tenant data. Create a real org in the SuperAdmin console.
SUPER_ADMIN_EMAIL=owner@goalcert.io
SUPER_ADMIN_PASSWORD=ChangeMe!2026
SUPER_ADMIN_NAME=Platform Owner

# ── Persistence ───────────────────────────────────────────────────────
# Default is a local SQLite file. That is fine for dev and WRONG for any deploy:
# on ECS/Fargate the file dies with the task, taking every user and org with it.
# DATABASE_URL=postgresql+psycopg://user:pass@db-host:5432/goalcert_hub
# DATABASE_URL=sqlite:///./goalcert_hub.db

# ── CORS ──────────────────────────────────────────────────────────────
# Only needed if the SPA is served from a different origin than this backend.
# In the recommended deploy the hub serves its own built SPA (hub/web/dist), so
# everything is same-origin and this can stay as-is.
CORS_ORIGINS=http://localhost:5180,http://localhost:5173

# ── Content-Security-Policy (PRODUCTION) ──────────────────────────────
# Comma-separated list of ORIGINS (scheme://host) that serve the federated
# remotes — i.e. your CloudFront distribution.
#
# Leave BLANK locally: no CSP header is sent and nothing changes. Set it in
# production, because the hub is a federation HOST — it loads remoteEntry.js and
# a stylesheet from each platform's origin at runtime. Ship a CSP without these
# and script-src blocks every remote: the app looks fine locally and every
# platform panel is dead in prod.
# REMOTE_ORIGINS=https://d111abcdef8.cloudfront.net
REMOTE_ORIGINS=

# ══ Secure gateway to the platforms ═══════════════════════════════════
# The hub is the ONLY thing that talks to these. Keys are injected server-side
# and never reach the browser. A blank BASE_URL makes that service 503 cleanly.
#
# DEPLOYMENT RULE: moving to AWS changes ONLY the *_BASE_URL values (+ the
# matching _API_KEY once keys are set). No code changes.

# 1) NextXR Digital Twin — serves /api/v1. Local: ./start.ps1 → :8080.
#    Dev-permissive auth: no key unless the twin sets NXR_API_KEYS.
TWIN_BASE_URL=http://localhost:8080
TWIN_API_KEY=
TWIN_PATH_PREFIX=/api/v1
TWIN_KEY_HEADER=X-API-Key

# 2) Scenario Engine — mounts its routers at the ROOT (/health, /scenarios,
#    /runs, /catalog...). SCENARIO_PATH_PREFIX MUST STAY EMPTY — the intuitive
#    "/api" 404s every scenario call. Do not "fix" it.
#
#    SCENARIO_API_KEY must match the key set on the engine. Blank means the
#    engine allows everything — fine locally, but the engine's multi-tenancy
#    trusts X-Goalcert-Org, which is only trustworthy because the gateway is the
#    sole ingress AND this key is set. Blank in prod = no tenancy.
SCENARIO_BASE_URL=http://127.0.0.1:8002
SCENARIO_API_KEY=
SCENARIO_PATH_PREFIX=
SCENARIO_KEY_HEADER=X-API-Key

# ── HiveMind (ex-AUTOMIND) — ONE deployment, THREE surfaces ───────────
# All three point at the same host. Locally that is :8097 (docker-compose maps
# 8097:8000); the CONTAINER listens on 8000, so on AWS use :8000.
# (An earlier default of :8001 here was wrong and produced 503s on /api/agents/run.)

# 2a) The auth-free capability facade the hub's own co-pilot calls.
AGENTS_BASE_URL=http://localhost:8097
AGENTS_API_KEY=
AGENTS_PATH_PREFIX=/api/v1/agents
AGENTS_KEY_HEADER=X-API-Key

# 2b) The guided Agent Builder facade (templates, create, tools, deploy).
#     The federated "Agent Builder" page drives this via /api/agentbuilder/*.
AGENTBUILDER_BASE_URL=http://localhost:8097
AGENTBUILDER_API_KEY=
AGENTBUILDER_PATH_PREFIX=/api/v1/builder
AGENTBUILDER_KEY_HEADER=X-API-Key

# 2c) HiveMind's per-user app API — what the FEDERATED HiveMind pages call.
#     ⚠ REQUIRED. gateway.py reads HIVEMIND_*; these were once left as AUTOMIND_*
#     after the rebrand, so the gateway saw an empty base and 503'd EVERY call the
#     HiveMind UI made while everything looked configured.
HIVEMIND_BASE_URL=http://localhost:8097
HIVEMIND_API_KEY=
HIVEMIND_PATH_PREFIX=/api
HIVEMIND_KEY_HEADER=X-API-Key

# AGENTS_API_KEY / AGENTBUILDER_API_KEY / HIVEMIND_API_KEY should all be set to
# HiveMind's HUB_API_KEY before deploying — without it HiveMind trusts the
# X-Goalcert-User identity from anyone who can reach it.

# ── The Hive brief engine ─────────────────────────────────────────────
# There is deliberately NO HIVE_BASE_URL. /api/hive/* is implemented by the HUB
# ITSELF (server.py: /run, /brief, /stream, /agents, /health) using the keys at
# the top of this file. A gateway entry for it registered /api/hive/{path} ahead
# of the hub's own routes and shadowed them — 503ing the whole Hive and the
# /api/hive/health probe the UI labels "Hub LLM Backend". Don't add one back.

# Server
PORT=8090
