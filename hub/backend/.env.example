# ── GoalCert Hub Backend — configuration ──────────────────────────────
# Copy to .env and fill in. Everything the browser must never see lives here.
#
# ┌────────────────────────────────────────────────────────────────────┐
# │ DEPLOYMENT RULE: when the three platforms move (e.g. to AWS),      │
# │ change ONLY the {TWIN,SCENARIO,AGENTS,AGENTBUILDER}_BASE_URL       │
# │ values (+ the matching _API_KEY once you set keys on the services).│
# │ Nothing else changes — not the frontend, not the code.             │
# └────────────────────────────────────────────────────────────────────┘

# LLM keys (HiveMind / agentic reasoning that the hub runs itself).
# ANY ONE of the three is enough — the hub tries Claude → OpenAI → Gemini.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514
OPENAI_MODEL=gpt-4o-mini

# ── Auth / identity ───────────────────────────────────────────────────
# Generate a strong secret:  openssl rand -hex 32   (or: python -c "import secrets;print(secrets.token_hex(32))")
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720

# First platform owner, seeded on first boot (change the password on first login)
SUPER_ADMIN_EMAIL=owner@goalcert.io
SUPER_ADMIN_PASSWORD=ChangeMe!2026
SUPER_ADMIN_NAME=Platform Owner

# ── Persistence ───────────────────────────────────────────────────────
# Any SQLAlchemy URL. Unset = the SQLite file next to the backend.
# DATABASE_URL=sqlite:///./goalcert_hub.db
# DATABASE_URL=mysql+pymysql://root@127.0.0.1:3306/goalcert_hub?charset=utf8mb4
# DATABASE_URL=postgresql+psycopg://user:pass@db-host:5432/goalcert
#
# The schema is managed by Alembic — see migrations/README.md.
#   python manage.py migrate                       apply pending migrations
#   python manage.py makemigrations -m "add x"     after editing models.py
# AUTO_MIGRATE=1 (default) migrates on server startup. Set 0 when the deploy
# runs `alembic upgrade head` itself (render.yaml does) — the server then only
# refuses to boot against an out-of-date schema.
AUTO_MIGRATE=1

# ── CORS ──────────────────────────────────────────────────────────────
# Only needed if the frontend is served from a DIFFERENT origin than this
# backend. In the recommended deploy the hub serves its own built SPA
# (hub/web/dist) so everything is same-origin and this can stay as-is.
CORS_ORIGINS=http://localhost:5180,http://localhost:5173

# ── Payment gateways ──────────────────────────────────────────────────
# Bootstrap only. On boot (and on every load of Payments) the hub copies any
# value here into the gateway's stored config IF that field is still blank,
# then Super Admin → Payments is the source of truth: rotate a key there and
# a stale value left in this file can never overwrite it.
#
# A gateway that gets its first credential this way switches itself on, and
# picks test vs live from the key prefix (rzp_test_ / sk_test_).
#
# Nothing here ever reaches the browser — the API returns which keys are set,
# never their values.

# Razorpay (INR) — dashboard → Settings → API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# dashboard → Settings → Webhooks; the secret you choose when adding the hook
RAZORPAY_WEBHOOK_SECRET=

# Stripe — dashboard → Developers → API keys
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal — developer.paypal.com → Apps & Credentials
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ── Secure gateway to the platforms ───────────────────────────────────
# Drop in the URL + key for each service and the stub goes real. Keys are
# injected server-side and never reach the browser. Blank BASE_URL = SIM.

# 1) NextXR Digital Twin — serves /api/v1 (local: ./start.ps1 → :8080).
#    Dev-permissive auth: no key needed unless the twin sets NXR_API_KEYS;
#    then put one of those keys in TWIN_API_KEY (sent as X-API-Key).
TWIN_BASE_URL=http://localhost:8080
TWIN_API_KEY=
TWIN_PATH_PREFIX=/api/v1
TWIN_KEY_HEADER=X-API-Key

# 2) GoalCert Simulation (Scenario) Engine — mounts its routers at the ROOT
#    (/health, /scenarios, /runs, /catalog, /studio, /tripwire, /jilla, /live),
#    so SCENARIO_PATH_PREFIX must stay EMPTY — the default "/api" would 404
#    every call. SCENARIO_API_KEY must match the key set on the engine itself
#    (blank = engine runs open, local dev only).
SCENARIO_BASE_URL=http://127.0.0.1:8002
SCENARIO_API_KEY=
SCENARIO_PATH_PREFIX=
SCENARIO_KEY_HEADER=X-API-Key

# 3) AUTOMIND Agentic AI — the co-pilot layer + every capability the other
#    platforms delegate to. Uses the auth-free hub facade at /api/v1/agents/*.
AGENTS_BASE_URL=http://localhost:8001
AGENTS_API_KEY=
AGENTS_PATH_PREFIX=/api/v1/agents
AGENTS_KEY_HEADER=X-API-Key

# 4) Agent Builder — served by the SAME AUTOMIND deployment through its hub
#    facade at /api/v1/builder/* (6-stage guided builder + team chat). Point
#    it at the same host as AGENTS_BASE_URL.
AGENTBUILDER_BASE_URL=http://localhost:8001
AGENTBUILDER_API_KEY=
AGENTBUILDER_PATH_PREFIX=/api/v1/builder
AGENTBUILDER_KEY_HEADER=X-API-Key

# Server
PORT=8090

# ─────────────────────────────────────────────────────────────────────
# SSO — the Hub as identity provider for the satellite LMS apps
# ─────────────────────────────────────────────────────────────────────
# "Open LMS" exchanges the signed-in user's Hub session for a one-shot,
# 60-second, audience-bound ticket and hands the browser to the LMS. No
# passwords are shared; the LMS reuses the admin account it already has.

# Goes in the ticket's `iss` claim. Must match HUB_SSO_ISSUER in the Laravel
# LMS .env character for character — neither side normalises it.
SSO_ISSUER=https://hub.goal-cert.com

# Signing material for TICKETS ONLY.
# MUST NOT equal JWT_SECRET above — that one signs 12-hour Hub session tokens,
# and sharing it would let a relying party mint them.
# Generate with: openssl rand -hex 48   (minimum 32 characters)
SSO_ALGORITHM=HS256
SSO_SECRET=

# RS256 alternative (recommended in production): the Hub holds the private key,
# each LMS holds only the matching public key and therefore cannot forge tickets.
#   openssl genrsa -out hub-sso-private.key 2048
#   openssl rsa -in hub-sso-private.key -pubout -out hub-sso-public.key
# SSO_ALGORITHM=RS256
# SSO_PRIVATE_KEY_PATH=/run/secrets/hub-sso-private.key

SSO_TICKET_TTL_SECONDS=60

# GoalCert LMS (Laravel)
SSO_LMS_AUDIENCE=goalcert-lms
SSO_LMS_CALLBACK_URL=https://goal-cert.com/sso/hub/callback
SSO_LMS_DEFAULT_TARGET=/admin/dashboard
SSO_LMS_ROLES=super_admin,admin
# Roles dropped straight into the LMS on sign-in, with no "Open LMS" click.
# Must be a subset of SSO_LMS_ROLES — a role that cannot open the app cannot be
# auto-launched into it either. Leave empty to require the click for everyone.
SSO_LMS_AUTOLAUNCH_ROLES=super_admin

# VR LMS (FastAPI)
SSO_VR_AUDIENCE=goalcert-vr
SSO_VR_CALLBACK_URL=https://vr.goal-cert.com/sso/hub/callback
SSO_VR_DEFAULT_TARGET=/dashboard
SSO_VR_ROLES=super_admin,admin
# Empty on purpose: one sign-in opens at most one tab, and the LMS wins.
SSO_VR_AUTOLAUNCH_ROLES=
